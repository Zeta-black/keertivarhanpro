/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

/model/*
  Cache-Control: public, max-age=31536000, immutable

# The RDKit runtime is a pinned, content-stable build; cache it hard so the 7 MB
# WebAssembly binary is fetched at most once per visitor.
/rdkit/*
  Cache-Control: public, max-age=31536000, immutable
